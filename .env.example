# ==============================================================================
# ÉLAN Fine Fragrances — Storefront (Frontend) Environment Example (.env.example)
# ==============================================================================
# Copy this file to .env or .env.local to customize API routing.
# Vite requires all client-exposed environment variables to start with VITE_
# ==============================================================================

# VITE_API_URL: Base URL for all REST API endpoints.
# Usage: Base endpoint used by Axios service (Elan_FE/src/services/api.js).
# Status: Optional in local development (Defaults to 'http://localhost:5000/api').
#         Required in production / deployment.
# Source:
#   - Local development: http://localhost:5000/api
#   - Staging: https://staging-api.elanperfume.com/api
#   - Production: https://api.elanperfume.com/api
VITE_API_URL=http://localhost:5000/api

# API_URL (server-side, Vercel only): same value as VITE_API_URL. Used by /api/seo and
# /api/sitemap to build product link previews and the dynamic sitemap. Falls back to
# VITE_API_URL if unset. Must be a public URL, not localhost.
API_URL=
